{
  "name": "desk",
  "version": "0.1.0",
  "description": "Kanban board for AI agents with an MCP server",
  "type": "module",
  "bin": {
    "desk": "dist/cli/index.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "npm run build:server && npm run build:ui",
    "build:server": "tsc -p tsconfig.build.json && node scripts/make-cli-executable.mjs",
    "build:ui": "vite build --config ui/vite.config.ts",
    "build:tui": "cd tui && go build -o bin/desk-tui ./cmd/desk-tui",
    "dev": "npm run build:server && concurrently -k -n api,ui -c blue,green \"node dist/cli/index.js ui\" \"npm:dev:ui\"",
    "dev:ui": "vite --config ui/vite.config.ts",
    "typecheck": "tsc --noEmit && vue-tsc --noEmit -p ui/tsconfig.json",
    "test": "vitest run",
    "test:tui": "cd tui && go vet ./... && go test -race -cover ./...",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "npm run build && playwright test",
    "check:package": "node scripts/check-package.mjs",
    "verify:release": "npm run typecheck && npm test && npm run test:tui && npm run test:e2e -- --project=chromium --project=webkit && npm run check:package",
    "test:e2e:headed": "npm run build && playwright test --headed"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.1",
    "chokidar": "4.0.3",
    "yaml": "^2.9.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@floating-ui/vue": "^1.0.6",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@life_uikit/uikit": "file:ui/vendor/tn-uikit",
    "@playwright/test": "^1.63.0",
    "@types/markdown-it": "^14.2.0",
    "@types/node": "^20.19.43",
    "@vitejs/plugin-vue": "^6.0.4",
    "@vitest/coverage-v8": "^3.2.7",
    "ajv": "^8.20.0",
    "click-outside-vue3": "^4.0.1",
    "concurrently": "^10.0.5",
    "markdown-it": "^14.3.2",
    "maska": "^3.0.0",
    "overlayscrollbars": "^2.11.5",
    "overlayscrollbars-vue": "^0.5.9",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vite": "^6.4.3",
    "vitest": "^3.2.7",
    "vue": "^3.5.0",
    "vue-draggable-plus": "^0.5.0",
    "vue-tsc": "^3.2.4",
    "vue3-touch-events": "^4.1.0"
  }
}
